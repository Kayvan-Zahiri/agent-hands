      "name": "confirmation",
      "type": "string",
      "description": "the confirmation number the app issued"
    }
  ],
  "business_rules": [
    {
      "code": "member_not_found",
      "when_text": "RECORD NOT FOUND",
      "message": "no member exists with that identifier",
      "terminal": true
    },
    {
      "code": "no_search_match",
      "when_text": "No member records matched",
      "message": "the search returned nothing",
      "terminal": true
    },
    {
      "code": "insufficient_funds",
      "when_text": "INSUFFICIENT FUNDS",
      "message": "the from-share does not hold that amount",
      "terminal": true
    },
    {
      "code": "transaction_rejected",
      "when_text": "TRANSACTION REJECTED",
      "message": "the application refused the transaction as entered",
      "terminal": true
    },
    {
      "code": "supervisor_required",
      "when_text": "SUPERVISOR OVERRIDE REQUIRED",
      "message": "this function needs a supervisor to sign on",
      "terminal": false
    }
  ],
